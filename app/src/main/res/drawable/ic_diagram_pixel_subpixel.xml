        android:pathData="M 215,200 A 5,5 0 1 1 225,200 A 5,5 0 1 1 215,200 Z" />
    <path
        android:fillColor="@color/champion_blue"
        android:pathData="M 395,200 A 5,5 0 1 1 405,200 A 5,5 0 1 1 395,200 Z" />
    <path
        android:fillColor="@color/white_convolvulus"
        android:pathData="M 575,200 A 5,5 0 1 1 585,200 A 5,5 0 1 1 575,200 Z" />
